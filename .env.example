# All values below are dev defaults — override in .env as needed.

# Database
# DATABASE_URL=postgresql://postgres:securepassword123@172.17.0.1:15432/datasets

# MLflow
# MLFLOW_TRACKING_URI=http://172.17.0.1:5000

# MinIO / S3 artifact store
# MLFLOW_S3_ENDPOINT_URL=http://172.17.0.1:9000
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin

# Governance (optional) — scan upstream pipeline governance.yaml files to attach
# input data lineage to MLflow runs. Without this, only project-level metadata
# from the local governance.yaml is tagged. With it, each consumed table's
# license, owner, and classification are also attached.
# Comma-separated glob patterns:
# GOVERNANCE_SEARCH_PATHS=/path/to/pipelines/apps/*/governance.yaml
